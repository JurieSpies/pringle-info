{
  "name": "pringle-info",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Overstrand emergency & community directory — static PWA",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "tailwindcss -i tailwind.source.css -o tailwind.css -m -c tailwind.config.js",
    "watch:css": "tailwindcss -i tailwind.source.css -o tailwind.css -m -c tailwind.config.js --watch",
    "test": "bun run tests/smoke.ts"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "tailwindcss": "^3.4.17"
  }
}
